{
  "name": "pokeledger-mcp",
  "version": "0.1.0",
  "description": "PokeLedger MCP server over Streamable HTTP with bearer authentication",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "pokeledger-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=tools/** --test-coverage-exclude=src/index.js --test-coverage-exclude=**/*.test.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100"
  },
  "engines": {
    "node": ">=22.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
